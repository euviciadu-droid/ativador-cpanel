<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- FOCO: borda branca grossa + moldura amarela externa para ficar MUITO visível -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FCD34D"/>
                    <corners android:radius="18dp"/>
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#FDE68A" android:endColor="#F59E0B" android:angle="270"/>
                    <corners android:radius="14dp"/>
                    <stroke android:width="3dp" android:color="#FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D97706"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FCD34D" android:endColor="#F59E0B" android:angle="270"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
